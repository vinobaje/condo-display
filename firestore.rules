rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Secrets (API keys, super-admin list) — separate collection so the public
    // settings read rule can never match it. Only logged-in admins read/write.
    match /secrets/{doc} {
      allow read, write: if request.auth != null;
    }
    // Public display settings (building name, theme, layout, weather, ticker)
    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Display heartbeat — one doc per TV; the unauthenticated TV writes a small
    // payload, admins read the list. Field allowlist prevents abuse. Deleting a
    // stale display requires login.
    match /status/{device} {
      allow read: if true;
      // Doc ids come from getDisplayDeviceId(): "tv_" + 8 chars (legacy "display" also allowed)
      allow create, update: if device.size() <= 16
                   && request.resource.data.keys().hasOnly(['last_seen', 'name', 'device'])
                   && request.resource.data.last_seen is string
                   && request.resource.data.last_seen.size() < 40
                   && (!('name' in request.resource.data)
                       || (request.resource.data.name is string
                           && request.resource.data.name.size() < 80))
                   && (!('device' in request.resource.data)
                       || (request.resource.data.device is string
                           && request.resource.data.device.size() < 200));
      allow delete: if request.auth != null;
    }
    match /notices/{noticeId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    // Reusable notice templates — admin-only content, not needed by the display
    match /templates/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
